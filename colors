        document.getElementById("simDotH").style.left = `${(hsb.h / 360) * 100}%`;
        document.getElementById("simDotS").style.left = `${hsb.s}%`;
        document.getElementById("simDotB").style.left = `${hsb.b}%`;

        const fullSatHex = hsbToHex(hsb.h, 100, hsb.b || 100);
        const zeroSatHex = hsbToHex(hsb.h, 0, hsb.b || 100);
        const fullBrightHex = hsbToHex(hsb.h, hsb.s, 100);

        document.getElementById("simTrackS").style.background = `linear-gradient(90deg, ${zeroSatHex}, ${fullSatHex})`;
        document.getElementById("simTrackB").style.background = `linear-gradient(90deg, #000000, ${fullBrightHex})`;
      }

      function openMatrixInspector(colorObj) {
        const hex = normalizeHex(colorObj.hex);
        const { r, g, b } = hexToRgb(hex);
        const hsb = rgbToHsb(r, g, b);
        state.inspectedColor = { name: colorObj.name, hex, rgb: { r, g, b }, hsb };

        updateProcreateSimulator(hex);

        const panel = document.getElementById("matrixPanel");
        panel.classList.add("open");

        document.getElementById("matrixHeroSwatch").style.backgroundColor = hex;
        document.getElementById("matrixColorName").textContent = colorObj.name;
        document.getElementById("matrixColorValues").textContent =
          `HEX: ${hex}  •  RGB: ${r}, ${g}, ${b}  •  Procreate HSB: ${hsb.h}°, ${hsb.s}%, ${hsb.b}%`;

        // Build 27-step Tint / Tone / Shade Variations (3 rows x 9 cols)
        const cellsContainer = document.getElementById("matrixCells");
        cellsContainer.innerHTML = "";

        const variations = [];
        // Row 1: Tints (High brightness, decreasing saturation toward pure light)
        for (let i = 0; i < 9; i++) {
          const sat = Math.round(10 + i * 11.25);
          variations.push({ label: `T${i + 1}`, hex: hsbToHex(hsb.h, sat, 100) });
        }
        // Row 2: Tones (Mid-high brightness, varied saturation)
        for (let i = 0; i < 9; i++) {
          const sat = Math.round(15 + i * 10.5);
          variations.push({ label: `M${i + 1}`, hex: hsbToHex(hsb.h, sat, 76) });
        }
        // Row 3: Shades (Deep shadow values)
        for (let i = 0; i < 9; i++) {
          const bri = Math.round(16 + i * 7.5);
          variations.push({ label: `S${i + 1}`, hex: hsbToHex(hsb.h, Math.max(25, hsb.s), bri) });
        }

        variations.forEach((v) => {
          const cell = document.createElement("div");
          cell.className = "matrix-cell";
          cell.style.backgroundColor = v.hex;
          cell.style.color = getContrastTextColor(v.hex);
          cell.title = `${colorObj.name} (${v.label}) — ${v.hex}`;
          cell.textContent = v.hex.slice(1);
          cell.addEventListener("click", () => {
            copyTextToClipboard(v.hex, `Copied ${v.hex} (${colorObj.name} ${v.label})`, v.hex);
            addColorToPalette({ name: `${colorObj.name} ${v.label}`, hex: v.hex });
            updateProcreateSimulator(v.hex);
          });
          cellsContainer.appendChild(cell);
        });

        // Build Procreate Color Harmonies
        renderHarmonyChips("harmonyComp", [
          hex,
          hsbToHex((hsb.h + 180) % 360, hsb.s, hsb.b)
        ], colorObj.name);

        renderHarmonyChips("harmonyAnalog", [
          hsbToHex((hsb.h - 30 + 360) % 360, hsb.s, hsb.b),
          hex,
          hsbToHex((hsb.h + 30) % 360, hsb.s, hsb.b)
        ], colorObj.name);

        renderHarmonyChips("harmonyTriad", [
          hex,
          hsbToHex((hsb.h + 120) % 360, hsb.s, hsb.b),
          hsbToHex((hsb.h + 240) % 360, hsb.s, hsb.b)
        ], colorObj.name);

        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function renderHarmonyChips(containerId, hexList, baseName) {
        const container = document.getElementById(containerId);
        container.innerHTML = "";
        hexList.forEach((hHex) => {
          const chip = document.createElement("div");
          chip.className = "harmony-chip";
          chip.style.backgroundColor = hHex;
          chip.title = `Harmony ${hHex} — Click to copy & add`;
          chip.addEventListener("click", () => {
            copyTextToClipboard(hHex, `Copied Harmony ${hHex}`, hHex);
            addColorToPalette({ name: `${baseName} Harmony`, hex: hHex });
          });
          container.appendChild(chip);
        });
      }

      /* ----------------------------------------------------------------------
         6. RENDER SPECTRUM GRID
         ---------------------------------------------------------------------- */
      function renderSpectrum() {
        const container = document.getElementById("spectrumContainer");
        container.innerHTML = "";
        const query = state.search.trim().toLowerCase();

        SPECTRUM_GROUPS.forEach((group) => {
          if (state.filter !== "all" && group.temp !== state.filter) {
            return;
          }

          const filteredColors = group.colors.filter((c) => {
            if (!query) return true;
            const rgb = hexToRgb(c.hex);
            const hsb = rgbToHsb(rgb.r, rgb.g, rgb.b);
            return (
              c.name.toLowerCase().includes(query) ||
              c.hex.toLowerCase().includes(query) ||
              group.title.toLowerCase().includes(query) ||
              `${hsb.h}`.includes(query)
            );
          });

          if (filteredColors.length === 0) return;

          const section = document.createElement("section");
          section.className = "section-group";
          section.id = group.id;

          const tagClass =
            group.temp === "warm"
              ? "tag-warm"
              : group.temp === "cool"
              ? "tag-cool"
              : "tag-neutral";

          section.innerHTML = `
            <div class="section-heading">
              <div class="section-title">
                <span>${group.title}</span>
                <span class="temp-tag ${tagClass}">${group.temp}</span>
              </div>
              <span style="font-size: 0.8rem; color: var(--text-secondary);">${group.description}</span>
            </div>
          `;

          const grid = document.createElement("div");
          grid.className = "swatch-grid";

          filteredColors.forEach((color) => {
            const shiftedHex = applyDarkLightShift(color.hex, state.darkLightValue);
            const hex = normalizeHex(shiftedHex);
            const rgb = hexToRgb(hex);
            const hsb = rgbToHsb(rgb.r, rgb.g, rgb.b);
            const rampColors = state.showAllRamps ? generate7StepRamp(color.hex) : [];

            const card = document.createElement("article");
            card.className = "swatch-card";
            card.setAttribute("tabindex", "0");
            card.setAttribute("role", "button");
            card.setAttribute("aria-label", `${color.name}, HEX ${hex}, HSB ${hsb.h} degrees, ${hsb.s} percent, ${hsb.b} percent`);

            const rampHtml = state.showAllRamps
              ? `<div class="inline-ramp-strip" title="Click any step on the Dark → Light ramp">${rampColors
                  .map(
                    (rHex, idx) =>
                      `<div class="ramp-step" data-ramp-hex="${rHex}" data-ramp-idx="${idx + 1}" style="background-color:${rHex};" title="Step ${idx + 1}/7: ${rHex}"></div>`
                  )
                  .join("")}</div>`
              : "";

            card.innerHTML = `
              <div class="swatch-color-area" style="background-color: ${hex};">
                <span class="swatch-badge">${hsb.h}° • B:${hsb.b}%</span>
                <div class="swatch-actions-overlay">
                  <button type="button" class="mini-icon-btn inspect-btn" title="Explore Tints, Shades & Harmonies">⊞</button>
                  <button type="button" class="mini-icon-btn add-btn" title="Add to 30-Swatch Procreate Palette">+</button>
                </div>
              </div>
              ${rampHtml}
              <div class="swatch-meta">
                <div class="swatch-name" title="${color.name}">${color.name}</div>
                <div class="swatch-hex-row">
                  <span>${hex}</span>
                  <span style="font-size: 0.68rem; color: var(--text-muted);">RGB ${rgb.r},${rgb.g},${rgb.b}</span>
                </div>
                <div class="swatch-hsb">HSB: ${hsb.h}° · ${hsb.s}% · ${hsb.b}%</div>
              </div>
            `;

            // Clicking main card copies HEX + updates Procreate simulator + adds to palette
            card.addEventListener("click", (e) => {
              const rampEl = e.target.closest(".ramp-step");
              if (rampEl) {
                const rHex = rampEl.dataset.rampHex;
                const rStep = rampEl.dataset.rampIdx;
                copyTextToClipboard(rHex, `Copied ${rHex} (${color.name} Value ${rStep}/7)`, rHex);
                updateProcreateSimulator(rHex);
                addColorToPalette({ name: `${color.name} V${rStep}`, hex: rHex });
                return;
              }
              if (e.target.closest(".inspect-btn")) {
                openMatrixInspector({ name: color.name, hex });
                return;
              }
              if (e.target.closest(".add-btn")) {
                addColorToPalette({ name: color.name, hex });
                showToast(`Added ${color.name} (${hex}) to Procreate Palette`, hex);
                return;
              }
              copyTextToClipboard(hex, `Copied ${hex} (${color.name}) — Ready to paste in Procreate!`, hex);
              updateProcreateSimulator(hex);
              addColorToPalette({ name: color.name, hex });
            });

            grid.appendChild(card);
          });

          section.appendChild(grid);
          container.appendChild(section);
        });

        if (container.innerHTML === "") {
          container.innerHTML = `
            <div style="text-align:center; padding: 40px; background: var(--bg-panel); border-radius: 14px; color: var(--text-secondary);">
              No colors matched your search filter. Try clearing the search bar or selecting "All Colors".
            </div>
          `;
        }
      }

      /* ----------------------------------------------------------------------
         6B. RENDER SKIN TONES 2D MATRIX & PORTRAIT LIGHTING SIMULATOR
         ---------------------------------------------------------------------- */
      function renderSkinTonesStudio() {
        const table = document.getElementById("skinMatrixTable");
        table.innerHTML = "";

        const visibleUndertones = SKIN_UNDERTONES.filter(
          (u) => state.skinUndertoneFilter === "all" || u.id === state.skinUndertoneFilter
        );

        // Header Row (Warm -> Cool Undertones)
        const thead = document.createElement("thead");
        const headRow = document.createElement("tr");
        headRow.innerHTML = `<th style="text-align:left; padding-left:12px;">Dark ↓ → Light Depth</th>`;
        visibleUndertones.forEach((u) => {
          headRow.innerHTML += `
            <th>
              <div>${u.label}</div>
              <div style="font-size:0.68rem; font-weight:400; color:var(--text-secondary);">${u.sub}</div>
            </th>
          `;
        });
        thead.appendChild(headRow);
        table.appendChild(thead);

        // Body Rows (Dark -> Light Value Depths)
        const tbody = document.createElement("tbody");
        SKIN_MATRIX_ROWS.forEach((row) => {
          if (state.skinDepthFilter !== "all" && row.depthId !== state.skinDepthFilter) {
            return;
          }
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td class="skin-depth-label">
              <div>${row.depthLabel}</div>
              <div style="font-size:0.68rem; font-weight:400; color:var(--text-muted);">${row.valueRange}</div>
            </td>
          `;

          visibleUndertones.forEach((u) => {
            const tone = row.tones[u.id];
            const hex = normalizeHex(tone.hex);
            const rgb = hexToRgb(hex);
            const hsb = rgbToHsb(rgb.r, rgb.g, rgb.b);
            const textColor = getContrastTextColor(hex);
            const isSelected = state.selectedSkin && state.selectedSkin.hex === hex;

            const td = document.createElement("td");
            const card = document.createElement("div");
            card.className = `skin-cell-card ${isSelected ? "selected-skin" : ""}`;
            card.style.backgroundColor = hex;
            card.style.color = textColor;
            card.title = `${tone.name} (${hex}) — Click to Copy HEX, generate Portrait Shadows/Highlights & add to Procreate Palette`;

            card.innerHTML = `
              <div style="font-size:0.78rem; font-weight:700; line-height:1.2;">${tone.name}</div>
              <div style="display:flex; justify-content:space-between; align-items:center; font-family:var(--font-mono); font-size:0.68rem; opacity:0.9; margin-top:6px;">
                <span>${hex}</span>
                <span>H:${hsb.h}° B:${hsb.b}%</span>
              </div>
            `;

            card.addEventListener("click", () => {
              state.selectedSkin = { name: tone.name, hex, undertone: u.id };
              copyTextToClipboard(hex, `Copied ${tone.name} (${hex})`, hex);
              updateProcreateSimulator(hex);
              addColorToPalette({ name: tone.name, hex });
              renderSkinTonesStudio();
            });

            td.appendChild(card);
            tr.appendChild(td);
          });

          tbody.appendChild(tr);
        });

        table.appendChild(tbody);
        renderSkinLightingTriad();
      }

      function renderSkinLightingTriad() {
        const base = state.selectedSkin;
        const hex = normalizeHex(base.hex);
        const { r, g, b } = hexToRgb(hex);
        const hsb = rgbToHsb(r, g, b);

        document.getElementById("selectedSkinTitle").textContent = `${base.name} (${hex})`;

        let shadowHue = hsb.h;
        let highlightHue = hsb.h;
        let subHue = (hsb.h - 6 + 360) % 360; // Warm blood subsurface shift

        if (state.skinLightingMode === "daylight") {
          // Warm sunlight (shift toward golden yellow) + Cool ambient shadows (shift toward violet/blue)
          highlightHue = hsb.h > 25 ? Math.min(42, hsb.h + 8) : Math.min(35, hsb.h + 10);
          shadowHue = (hsb.h - 16 + 360) % 360;
        } else if (state.skinLightingMode === "moonlight") {
          // Cool blue/cyan key light + Warm amber bounce shadow
          highlightHue = 205;
          shadowHue = Math.min(28, hsb.h + 6);
        }

        const deepShadowHex = hsbToHex(
          shadowHue,
          Math.min(92, hsb.s + 14),
          Math.max(10, Math.round(hsb.b * 0.52))
        );
        const subsurfaceHex = hsbToHex(
          subHue,
          Math.min(95, hsb.s + 16),
          Math.max(16, Math.round(hsb.b * 0.78))
        );
        const highlightHex = hsbToHex(
          highlightHue,
          state.skinLightingMode === "moonlight" ? Math.max(18, Math.round(hsb.s * 0.55)) : Math.max(10, Math.round(hsb.s * 0.65)),
          Math.min(100, Math.round(hsb.b + (100 - hsb.b) * 0.58))
        );

        const roles = [
          { role: "1. Core Shadow", desc: "Ambient occlusion & form shadow", hex: deepShadowHex },
          { role: "2. Subsurface Transition", desc: "Warm blood-flow terminator", hex: subsurfaceHex },
          { role: "3. Base Skin Midtone", desc: "Local pigment value", hex: hex },
          { role: "4. Key Specular Highlight", desc: "Direct light plane", hex: highlightHex }
        ];

        const container = document.getElementById("skinTriadPreview");
        container.innerHTML = "";

        roles.forEach((item) => {
          const itemRgb = hexToRgb(item.hex);
          const itemHsb = rgbToHsb(itemRgb.r, itemRgb.g, itemRgb.b);
          const fg = getContrastTextColor(item.hex);

          const box = document.createElement("div");
          box.className = "skin-role-box";
          box.style.backgroundColor = item.hex;
          box.style.color = fg;
          box.title = `Click to copy ${item.hex} & add to Procreate Palette`;

          box.innerHTML = `
            <div style="font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; opacity:0.85;">${item.role}</div>
            <div style="font-size:0.95rem; font-weight:800; font-family:var(--font-mono);">${item.hex}</div>
            <div style="font-size:0.74rem; font-family:var(--font-mono);">HSB: ${itemHsb.h}° · ${itemHsb.s}% · ${itemHsb.b}%</div>
            <div style="font-size:0.72rem; opacity:0.85;">${item.desc}</div>
          `;

          box.addEventListener("click", () => {
            copyTextToClipboard(item.hex, `Copied ${item.role}: ${item.hex}`, item.hex);
            updateProcreateSimulator(item.hex);
            addColorToPalette({ name: `${base.name} (${item.role.slice(3)})`, hex: item.hex });
          });

          container.appendChild(box);
        });
      }

      /* ----------------------------------------------------------------------
         7. 30-SWATCH PROCREATE PALETTE BUILDER
         ---------------------------------------------------------------------- */
      function addColorToPalette(item) {
        const hex = normalizeHex(item.hex);
        // Prevent consecutive duplicates while allowing intentional variations
        if (state.palette.length > 0 && state.palette[state.palette.length - 1].hex === hex) {
          return;
        }
        if (state.palette.length >= 30) {
          showToast("Procreate palette is full (30/30 swatches). Click any slot to remove.", hex);
          return;
        }
        state.palette.push({ name: item.name, hex });
        savePaletteState();
        renderProcreateDock();
      }

      function renderProcreateDock() {
        const grid = document.getElementById("procreate30Grid");
        const badge = document.getElementById("paletteCountBadge");
        grid.innerHTML = "";
        badge.textContent = `${state.palette.length} / 30 Swatches`;

        for (let i = 0; i < 30; i++) {
          const slot = document.createElement("div");
          const entry = state.palette[i];
          if (entry) {
            slot.className = "procreate-slot filled";
            slot.style.backgroundColor = entry.hex;
            slot.title = `#${i + 1}: ${entry.name} (${entry.hex}) — Click to Copy HEX • Double-click to Remove`;

            slot.addEventListener("click", () => {
              copyTextToClipboard(entry.hex, `Copied Slot #${i + 1}: ${entry.hex}`, entry.hex);
              updateProcreateSimulator(entry.hex);
            });

            slot.addEventListener("dblclick", () => {
              state.palette.splice(i, 1);
              savePaletteState();
              renderProcreateDock();
              showToast(`Removed swatch #${i + 1}`, "#ef4444");
            });
          } else {
            slot.className = "procreate-slot";
            slot.title = `Empty Procreate Swatch Slot #${i + 1}`;
          }
          grid.appendChild(slot);
        }
      }

      /* ----------------------------------------------------------------------
         8. OFFLINE DOWNLOADS & EVENT LISTENERS
         ---------------------------------------------------------------------- */
      function triggerFileDownload(filename, content, mimeType) {
        const blob = new Blob([content], { type: mimeType });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

