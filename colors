        const fullHtml = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
        triggerFileDownload("index.html", fullHtml, "text/html;charset=utf-8");
        showToast("Downloaded free offline app (index.html)!", "#10b981");
      }

