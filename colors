      // Shifts any base HEX darker (<50) or lighter (>50) while preserving hue character
      function applyDarkLightShift(baseHex, sliderVal) {
        const hex = normalizeHex(baseHex);
        if (sliderVal === 50) return hex;
        const { r, g, b } = hexToRgb(hex);
        const hsb = rgbToHsb(r, g, b);

        if (sliderVal < 50) {
          // Darken toward deep shadow (slider 0 -> ~10% of original brightness, slightly richer sat)
          const factor = 0.12 + (sliderVal / 50) * 0.88;
          const newB = Math.max(6, Math.round(hsb.b * factor));
          const newS = hsb.s === 0 ? 0 : Math.min(100, Math.round(hsb.s + (50 - sliderVal) * 0.25));
          return hsbToHex(hsb.h, newS, newB);
        } else {
          // Lighten toward pastel tint (slider 100 -> high brightness, lower saturation)
          const t = (sliderVal - 50) / 50; // 0 to 1
          const newB = Math.min(100, Math.round(hsb.b + (100 - hsb.b) * t));
          const newS = hsb.s === 0 ? 0 : Math.max(6, Math.round(hsb.s * (1 - t * 0.85)));
          return hsbToHex(hsb.h, newS, newB);
        }
      }

