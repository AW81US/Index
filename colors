      document.getElementById("skinLightingModes").addEventListener("click", (e) => {
        const btn = e.target.closest(".pill-btn");
        if (!btn) return;
        document.querySelectorAll("#skinLightingModes .pill-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        state.skinLightingMode = btn.dataset.light;
        renderSkinLightingTriad();
      });

      document.getElementById("loadSkinPaletteBtn").addEventListener("click", () => {
        state.palette = [
          { name: "Deep Warm Espresso", hex: "#382015" },
          { name: "Deep Plum Ebony", hex: "#2B1822" },
          { name: "Warm Cacao Roast", hex: "#4D2C1B" },
          { name: "Rich Terracotta Mocha", hex: "#6B3D24" },
          { name: "Rich Rosewood Brown", hex: "#6B393D" },
          { name: "Golden Copper Bronze", hex: "#8C5230" },
          { name: "Warm Olive Sienna", hex: "#82593B" },
          { name: "Spiced Golden Caramel", hex: "#AD6B3E" },
          { name: "Sunlit Honey Amber", hex: "#C98653" },
          { name: "Mediterranean Olive", hex: "#BC8C60" },
          { name: "Golden Apricot Sand", hex: "#DDA06B" },
          { name: "Peachy Rose Sand", hex: "#D99897" },
          { name: "Warm Honey Peach", hex: "#EBB884" },
          { name: "Rosy Shell Ivory", hex: "#F3C6C6" },
          { name: "Golden Silk Porcelain", hex: "#FCE1C2" }
        ];
        savePaletteState();
        renderProcreateDock();
        showToast("Loaded 15-Swatch Portrait Skin Tone Set (Dark → Light, Warm ↔ Cool)!", "#c98653");
      });

      // Category Filter Pills
      document.getElementById("categoryFilters").addEventListener("click", (e) => {
        const btn = e.target.closest(".pill-btn");
        if (!btn) return;
        document.querySelectorAll(".pill-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        state.filter = btn.dataset.filter;
        renderSpectrum();
      });

      // Search Input
      document.getElementById("searchInput").addEventListener("input", (e) => {
        state.search = e.target.value;
        renderSpectrum();
      });

      // Continuous Warm-to-Cool Temperature Slider (Smoothly scrolls to matching section)
      document.getElementById("tempSlider").addEventListener("input", (e) => {
        const val = Number(e.target.value);
        if (state.filter !== "all") {
          state.filter = "all";
          document.querySelectorAll(".pill-btn").forEach((b) => b.classList.remove("active"));
          document.querySelector('.pill-btn[data-filter="all"]').classList.add("active");
          renderSpectrum();
        }

        // Find closest spectrum section by tempScore
        let closest = SPECTRUM_GROUPS[0];
        let minDiff = Infinity;
        SPECTRUM_GROUPS.forEach((g) => {
          const diff = Math.abs(g.tempScore - val);
          if (diff < minDiff) {
            minDiff = diff;
            closest = g;
          }
        });

        document.getElementById("sliderStatusLabel").textContent = `Temperature Focus: ${closest.title}`;
        const el = document.getElementById(closest.id);
        if (el) {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });

      // Matrix Inspector Buttons
      document.getElementById("matrixCloseBtn").addEventListener("click", () => {
        document.getElementById("matrixPanel").classList.remove("open");
      });

      document.getElementById("matrixCopyHexBtn").addEventListener("click", () => {
        if (!state.inspectedColor) return;
        copyTextToClipboard(state.inspectedColor.hex, `Copied ${state.inspectedColor.hex}`, state.inspectedColor.hex);
      });

      document.getElementById("matrixCopyHsbBtn").addEventListener("click", () => {
        if (!state.inspectedColor) return;
        const { h, s, b } = state.inspectedColor.hsb;
        const text = `H:${h}° S:${s}% B:${b}%`;
        copyTextToClipboard(text, `Copied ${text}`, state.inspectedColor.hex);
      });

      document.getElementById("matrixAddPaletteBtn").addEventListener("click", () => {
        if (!state.inspectedColor) return;
        addColorToPalette(state.inspectedColor);
        showToast(`Added ${state.inspectedColor.name} to Procreate Palette`, state.inspectedColor.hex);
      });

      // Dock Palette Actions
      document.getElementById("loadStarterWarmCoolBtn").addEventListener("click", () => {
        state.palette = [
          { name: "Cadmium Scarlet", hex: "#FF2400" },
          { name: "Vermilion Flame", hex: "#E34234" },
          { name: "International Orange", hex: "#FF4F00" },
          { name: "Amber Gold", hex: "#FFBF00" },
          { name: "Cadmium Yellow", hex: "#FFF600" },
          { name: "Warm Cream", hex: "#F5F5DC" },
          { name: "Raw Sienna", hex: "#D68A59" },
          { name: "Burnt Sienna", hex: "#E97451" },
          { name: "Warm Umber", hex: "#635147" },
          { name: "Sage Leaf", hex: "#9DC183" },
          { name: "Emerald Jewel", hex: "#50C878" },
          { name: "Turquoise Bright", hex: "#40E0D0" },
          { name: "Cerulean", hex: "#007BA7" },
          { name: "Cobalt Blue", hex: "#0047AB" },
          { name: "Indigo Dye", hex: "#4B0082" }
        ];
        savePaletteState();
        renderProcreateDock();
        showToast("Loaded 15-Color Warm-to-Cool Artist Starter Palette!", "#ff6b35");
      });

      document.getElementById("copyAllHexBtn").addEventListener("click", () => {
        if (state.palette.length === 0) {
          showToast("Your palette is empty — click any swatch to add colors first.", "#3b82f6");
          return;
        }
        const hexList = state.palette.map((c) => c.hex).join(", ");
        copyTextToClipboard(hexList, `Copied ${state.palette.length} HEX codes to clipboard!`, state.palette[0].hex);
      });

      document.getElementById("exportJsonBtn").addEventListener("click", () => {
        if (state.palette.length === 0) {
          showToast("Add at least 1 swatch before exporting.", "#3b82f6");
          return;
        }
        const exportObj = {
          app: "ChromaStudio Procreate Palette",
          exportedAt: new Date().toISOString(),
          swatchCount: state.palette.length,
          swatches: state.palette.map((c) => {
            const rgb = hexToRgb(c.hex);
            const hsb = rgbToHsb(rgb.r, rgb.g, rgb.b);
            return { name: c.name, hex: c.hex, rgb, procreateHSB: hsb };
          })
        };
        triggerFileDownload(
          "Procreate_30_Swatch_Palette.json",
          JSON.stringify(exportObj, null, 2),
          "application/json"
        );
        showToast("Exported Procreate Palette JSON!", "#10b981");
      });

      document.getElementById("clearPaletteBtn").addEventListener("click", () => {
        state.palette = [];
        savePaletteState();
        renderProcreateDock();
        showToast("Cleared Procreate Palette Dock", "#71717a");
      });

      // Initialize App on Load
      window.addEventListener("DOMContentLoaded", () => {
        renderSpectrum();
        renderSkinTonesStudio();
        renderProcreateDock();
        updateProcreateSimulator("#FF4F00");
      });
    })();
  </script>
</body>
</html>
